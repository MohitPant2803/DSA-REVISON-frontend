{
  "expo": {
    "name": "ReeWise",
    "slug": "dsa-revision-app",
    "version": "1.0.0",
    "scheme": "dsareels",
    "orientation": "portrait",
    "icon": "./assets/icon213.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F7"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#FAF9F7"
    },
    "android": {
      "package": "com.mohit.dsareels",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon213.png",
        "backgroundColor": "#FAF9F7"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "dsareels",
              "host": "auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a9bc232-b6d9-44f3-abbf-428860c7db19"
      }
    }
  }
}
